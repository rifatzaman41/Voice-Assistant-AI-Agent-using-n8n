        "promptType": "define",
        "text": "=\nreturn [\n  {\n    json: {\n      success: true,\n      message: `Thank you {{ $json.userInfo.Name }}! Your appointment with Rifat Labs has been successfully scheduled for {{ $json.userInfo.DateTime }}. We have noted your contact number as {{ $json.userInfo.Phone }} and your company as {{ $json.userInfo.Company }}. We look forward to meeting you and will reach out if there are any updates regarding your appointment.`,\n      appointment: {\n        name: {{ $json.userInfo.Name }},\n        phone: {{ $json.userInfo.Phone }},\n        company: {{ $json.userInfo.Company }},\n        dateTime: {{ $json.userInfo.DateTime }}\n      }\n    }\n  }\n];\n",
