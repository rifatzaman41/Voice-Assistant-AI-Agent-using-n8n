    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\n\n\nconst input = $input.first().json;\n\n// Get tool call information from the incoming webhook\nconst body = input.body ?? input;\nconst message = body.message ?? body;\n\nconst toolCall =\n  message.toolCalls?.[0] ??\n  message.toolCallList?.[0] ??\n  message.toolWithCallList?.[0] ??\n  null;\n\n// Extract function arguments\nconst args = toolCall?.function?.arguments ?? {};\n\n// Handle arguments that arrive as a JSON string\nconst userInfo =\n  typeof args === \"string\" ? JSON.parse(args) : args;\n\n// Create the appointment request\nconst request = {\n  Name: $input.first().json.body.message.toolWithToolCallList[0].toolCall.function.arguments.Name,\n  Phone: $input.first().json.body.message.toolWithToolCallList[0].toolCall.function.arguments.Phone,\n  Company: $input.first().json.body.message.toolWithToolCallList[0].toolCall.function.arguments.Company,\n  DateTime: $input.first().json.body.message.toolWithToolCallList[0].toolCall.function.arguments.DateTime\n};\n\n// Return the extracted user information\nreturn [\n  {\n    json: {\n      userInfo: request,\n      toolCallId: toolCall?.id ?? null,\n      webhookUrl:\n        \"https://n8n.srv1106977.hstgr.cloud/webhook-test/appointment\",\n      executionMode: \"test\"\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
